# =======================
# Roast App - Environment Variables
# =======================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- Neon Postgres ---
DB_URL=jdbc:postgresql://<your-neon-host>/neondb?sslmode=require
DB_USER=<your-neon-user>
DB_PASSWORD=<your-neon-password>

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=<generate-a-random-256-bit-key>

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>

# --- Spotify OAuth ---
SPOTIFY_CLIENT_ID=<your-spotify-client-id>
SPOTIFY_CLIENT_SECRET=<your-spotify-client-secret>

# --- Google OAuth (YouTube) ---
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# --- Groq LLM ---
GROQ_API_KEYS=<optional-comma-separated-keys-for-rotation>
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cloudflare R2 (for share-service, Step 7) ---
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key>
R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
R2_BUCKET_NAME=roast-cards
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- App Config ---
ROAST_DAILY_LIMIT=3
FRONTEND_URL=http://localhost:5173
